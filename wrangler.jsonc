{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konsole",
  "compatibility_date": "2026-05-16",
  "routes": [
    { "pattern": "konsole.le-roux.dev", "custom_domain": true }
  ],
  "assets": {
		"not_found_handling": "single-page-application"
	},
  "observability": {
		"enabled": true
	}
}
